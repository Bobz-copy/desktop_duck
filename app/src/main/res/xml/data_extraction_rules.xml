<?xml version="1.0" encoding="utf-8"?>
<!--
   Copia de seguridad y transferencia entre equipos (Android 12 y posteriores).
   Mismo criterio que backup_rules.xml: se respalda la mascota, no las claves
   cifradas (no se pueden descifrar en otro teléfono) ni los modelos descargados.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="config.ini" />
        <include domain="file" path="brain/" />
        <include domain="sharedpref" path="GooseEvolutionPrefs.xml" />
        <include domain="sharedpref" path="goose_llm_memory.xml" />
        <include domain="sharedpref" path="goose_brain.xml" />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="config.ini" />
        <include domain="file" path="brain/" />
        <include domain="sharedpref" path="GooseEvolutionPrefs.xml" />
        <include domain="sharedpref" path="goose_llm_memory.xml" />
        <include domain="sharedpref" path="goose_brain.xml" />
    </device-transfer>
</data-extraction-rules>
