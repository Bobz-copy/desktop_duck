<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/DefToolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:title="@string/app_name" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        tools:ignore="UseSwitchCompatOrMaterialXml">



        <Switch
            android:id="@+id/GooseDroid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:text="@string/app_name"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/BrainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/BrainOpen" />

        <!-- Pet Mode Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/PetMode"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Switch
                    android:id="@+id/PetModeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/EnablePetMode" />

                <Switch
                    android:id="@+id/TouchableSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/EnableTouch"
                    android:visibility="gone" />

                <!-- Pet Status Display -->
                <TextView
                    android:id="@+id/PetStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/PetStatus"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Hunger Bar -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Hunger"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:id="@+id/HungerLabel" />

                <ProgressBar
                    android:id="@+id/HungerBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#FF9800"
                    android:visibility="gone" />

                <!-- Energy Bar -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Energy"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:id="@+id/EnergyLabel" />

                <ProgressBar
                    android:id="@+id/EnergyBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#4CAF50"
                    android:visibility="gone" />

                <!-- Happiness Bar -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Happiness"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:id="@+id/HappinessLabel" />

                <ProgressBar
                    android:id="@+id/HappinessBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="75"
                    android:progressTint="#E91E63"
                    android:visibility="gone" />

                <!-- Hygiene Bar -->
                <TextView
                    android:id="@+id/HygieneLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/Hygiene"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/HygieneBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#03A9F4"
                    android:visibility="gone" />

                <!-- Health Bar -->
                <TextView
                    android:id="@+id/HealthLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/Health"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/HealthBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#8BC34A"
                    android:visibility="gone" />

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/FeedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/Feed"
                        android:textSize="12sp"
                        android:visibility="gone"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/PlayButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/Play"
                        android:textSize="12sp"
                        android:visibility="gone"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/SleepButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/Sleep"
                        android:textSize="12sp"
                        android:visibility="gone"
                        style="@style/Widget.Material3.Button.TonalButton" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/CleanButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/Clean"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/HealButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/Heal"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Customize Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/CustomizeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/Customize"
                    android:visibility="gone"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Config" />

        <Switch
            android:id="@+id/EnableMods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/EnableMods" />

        <Switch
            android:id="@+id/SilenceSounds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/SilenceSounds" />

        <Switch
            android:id="@+id/TaskCanAttackMouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/Task_CanAttackMouse" />

        <Switch
            android:id="@+id/AttackRandomly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/AttackRandomly" />

        <Switch
            android:id="@+id/UseCustomColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/UseCustomColors" />

        <Switch
            android:id="@+id/ShowShadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ShowShadow" />

        <!-- M3 TextInputEditText -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/GooseDefaultWhite">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/GooseDefaultWhite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="#ffffff" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/GooseDefaultOrange">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/GooseDefaultOrange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="#ffa500" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/GooseDefaultOutline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/GooseDefaultOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="#d3d3d3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Wandering time EditTexts -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/MinWanderingTimeSeconds">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/MinWanderingTimeSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/MaxWanderingTimeSeconds">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/MaxWanderingTimeSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/FirstWanderTimeSeconds">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/FirstWanderTimeSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/DrawSize">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/DrawSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="1.0" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/Update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/Update" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/SaveConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/SaveConfig" />

    </LinearLayout>
    </ScrollView>

</LinearLayout>

